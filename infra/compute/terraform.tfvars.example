# terraform.tfvars로 복사해서 사용한다. terraform.tfvars는 커밋하지 않는다.

# kubectl을 쓸 IAM 주체. SSO라면 aws sts get-caller-identity의 역할 ARN(assumed-role이 아니라 role)
cluster_admin_principal_arns = ["arn:aws:iam::123456789012:role/aws-reserved/sso.amazonaws.com/ap-northeast-2/AWSReservedSSO_AdministratorAccess_0123456789abcdef"]

# EKS API 공개 엔드포인트를 열 IP. 작업 PC의 공인 IP/32
cluster_endpoint_public_access_cidrs = ["203.0.113.10/32"]

# VPC origin을 만든 첫 apply 뒤에 true로 바꾼다. 다시 false가 되면 ALB 인바운드가 CloudFront prefix list로 넓어진다
enable_vpc_origin_sg_only = false
